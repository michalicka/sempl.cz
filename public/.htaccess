# Success Empire Ltd. – static site (Apache). Ignored harmlessly on pure nginx.

Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS + www canonical
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://www.sempl.cz%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^sempl\.cz$ [NC]
  RewriteRule ^ https://www.sempl.cz%{REQUEST_URI} [L,R=301]

  # Old WordPress pages (/cookies/ is kept as a standalone page)
  RewriteRule ^kontakt/?$ /#kontakt [NE,L,R=301]
  RewriteRule ^feed/?$ / [L,R=301]

  # Old WordPress internals are gone for good
  RewriteRule ^(wp-admin|wp-content|wp-includes|wp-json)(/|$) - [G,L]
  RewriteRule ^(wp-login|xmlrpc|wp-config|wp-cron)\.php$ - [G,L]

  # Never serve dotfiles or backups (except .well-known)
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule \.(bak|old|orig|sql|log|ini|sh|md)$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header unset X-Powered-By

  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff2|png|jpg|jpeg|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
